{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentReins",
  "version": "1.2.1",
  "identifier": "com.agentreins.windows",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../apps/desktop-ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:*; script-src 'self' http://127.0.0.1:*; style-src 'self' http://127.0.0.1:*; img-src 'self' data: http://127.0.0.1:*; font-src 'self' http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:*; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": ["msi"],
    "useLocalToolsDir": true,
    "resources": {
      "../../apps/desktop-ui/dist/": "ui/",
      "../../scripts/get-workbuddy-semantic-observer-status.ps1": "scripts/get-workbuddy-semantic-observer-status.ps1",
      "../../scripts/install-agentreins-observer-service.ps1": "scripts/install-agentreins-observer-service.ps1",
      "../../scripts/run-workbuddy-semantic-observer-host.ps1": "scripts/run-workbuddy-semantic-observer-host.ps1",
      "../../scripts/start-workbuddy-semantic-observer.ps1": "scripts/start-workbuddy-semantic-observer.ps1",
      "../../scripts/stop-workbuddy-semantic-observer.ps1": "scripts/stop-workbuddy-semantic-observer.ps1",
      "../../scripts/update-workbuddy-semantic-evidence.ps1": "scripts/update-workbuddy-semantic-evidence.ps1"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
